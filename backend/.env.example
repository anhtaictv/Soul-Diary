# =============================================
# Nhật Ký Cảm Xúc Số — Environment Variables
# Đổi tên file này thành .env trước khi chạy
# =============================================

# Server
PORT=3001
NODE_ENV=development

# JWT — đổi thành chuỗi random dài ít nhất 32 ký tự
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Mã hoá at-rest nội dung nhật ký (AES-256-GCM) — BẮT BUỘC, server sẽ không start nếu thiếu.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ MẤT KEY NÀY = MẤT VĨNH VIỄN TOÀN BỘ NỘI DUNG NHẬT KÝ ĐÃ MÃ HOÁ, không thể khôi phục.
# Lưu key ở nơi an toàn riêng (password manager), không chỉ trong file .env trên server.
# Local .env và .env production PHẢI dùng cùng 1 giá trị.
ENCRYPTION_KEY=change_this_generate_with_the_command_above

# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_db_password
DB_NAME=NhatKyCamXuc
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5500

# =============================================
# AI — thứ tự ưu tiên: AI Gateway → Gemini → rule-based
# =============================================

# AI Gateway (C:\ai-gateway trên VPS) — chuẩn OpenAI, phía sau là Ollama qua Tailscale
# và tự fallback Claude. Lấy AI_GATEWAY_API_KEY = GATEWAY_API_KEY trong C:\ai-gateway\.env.
# Bỏ trống key (hoặc AI_GATEWAY_ENABLED=0) thì app quay về gọi Gemini trực tiếp.
AI_GATEWAY_URL=http://127.0.0.1:8080
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=1
# Ollama nạp lại model có thể mất 30-60s nên timeout để rộng (chat riêng dùng 45s).
AI_GATEWAY_TIMEOUT_MS=90000
# Gateway lỗi thì ngưng gọi trong bấy nhiêu ms rồi mới thử lại, tránh mỗi request đều
# phải chờ hết timeout mới rơi xuống Gemini.
AI_GATEWAY_COOLDOWN_MS=120000

# Gemini — dự phòng khi gateway không dùng được. Bỏ trống thì bỏ qua luôn bước này.
GEMINI_API_KEY=
